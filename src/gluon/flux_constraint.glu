// FLUX Constraint Engine — Gluon (2016, Static-typed Functional Scripting)
// Pure INT8 saturated constraint checking. Zero dependencies.
//
// The insight: Haskell's types, Python's ergonomics. Constraint checking
// with type safety that doesn't get in your way. Type inference means
// minimal annotations. Pattern matching covers every case.
//
// "Haskell's types, Python's ergonomics. Constraint checking with
//  type safety that doesn't get in your way."

// ── Constants ──────────────────────────────────────────────────────

let int8_min = -127
let int8_max = 127
let max_constraints = 8

// ── Severity Type ───────────────────────────────────────────────────

type Severity = | Pass | Caution | Warning | Critical

let severity_to_int sev = match sev with
    | Pass -> 0
    | Caution -> 1
    | Warning -> 2
    | Critical -> 3

let severity_to_string sev = match sev with
    | Pass -> "PASS"
    | Caution -> "CAUTION"
    | Warning -> "WARNING"
    | Critical -> "CRITICAL"

// ── Constraint Type ─────────────────────────────────────────────────

type Constraint = { lo: Int, hi: Int, name: String }

// ── FluxResult Type ─────────────────────────────────────────────────

type FluxResult = {
    error_mask: Int,
    severity: Severity,
    violated_lo: Int,
    violated_hi: Int,
    violated_count: Int,
    passed: Bool
}

// ── Saturate ────────────────────────────────────────────────────────

let saturate val : Int -> Int =
    if val < int8_min then int8_min
    else if val > int8_max then int8_max
    else val

// ── Severity Classification ─────────────────────────────────────────

let classify_severity violated_count total =
    if violated_count == 0 then Pass
    else if violated_count <= total / 4 then Caution
    else if violated_count <= total / 2 then Warning
    else Critical

// ── Check ───────────────────────────────────────────────────────────
// Recursively walk the constraint list, accumulating the result.

let check constraints value : Array Constraint -> Int -> FluxResult =
    let val = saturate value
    let nc = Array.length constraints

    let rec loop i em vlo vhi vc =
        if i >= nc then (em, vlo, vhi, vc)
        else
            let c = constraints[i]
            let lo = saturate c.lo
            let hi = saturate c.hi
            let lo_fail = val < lo
            let hi_fail = val > hi
            let bit = 1 << i
            let new_em = if lo_fail || hi_fail then em || bit else em
            let new_vlo = if lo_fail then vlo || bit else vlo
            let new_vhi = if hi_fail then vhi || bit else vhi
            let new_vc = if lo_fail || hi_fail then vc + 1 else vc
            loop (i + 1) new_em new_vlo new_vhi new_vc

    let (error_mask, violated_lo, violated_hi, violated_count) =
        loop 0 0 0 0 0

    {
        error_mask,
        severity = classify_severity violated_count nc,
        violated_lo,
        violated_hi,
        violated_count,
        passed = violated_count == 0
    }

// ── Batch Check ─────────────────────────────────────────────────────

let check_batch constraints values : Array Constraint -> Array Int -> Array FluxResult =
    Array.map (check constraints) values

// ── Create Checker (with validation) ────────────────────────────────

type CheckerError = | EmptyConstraints | TooManyConstraints

let make_checker constraints : Array Constraint -> Result (Array Constraint) CheckerError =
    let nc = Array.length constraints
    if nc == 0 then Err EmptyConstraints
    else if nc > max_constraints then Err TooManyConstraints
    else Ok constraints

// ── Industry Presets ────────────────────────────────────────────────

let aviation : Array Constraint = [
    { lo = -55, hi = 70,  name = "cabin_temp_C" },
    { lo = 75,  hi = 101, name = "cabin_pressure_kPa" },
    { lo = 0,   hi = 100, name = "fuel_flow_pct" },
    { lo = 60,  hi = 100, name = "hydraulic_pct" },
]

let medical : Array Constraint = [
    { lo = 36, hi = 38,  name = "body_temp_C" },
    { lo = 60, hi = 100, name = "heart_rate_bpm" },
    { lo = 95, hi = 100, name = "spo2_pct" },
    { lo = 80, hi = 120, name = "bp_systolic_mmHg" },
]

let nuclear : Array Constraint = [
    { lo = 0,  hi = 110, name = "neutron_flux_pct" },
    { lo = 0,  hi = 65,  name = "core_temp_C_x10" },
    { lo = 72, hi = 100, name = "pressurizer_pct" },
    { lo = 0,  hi = 100, name = "coolant_flow_pct" },
]

// ── Usage Example ───────────────────────────────────────────────────
//
//   let r = check aviation 60
//   print (severity_to_string r.severity)  // "CAUTION"
//   print r.passed                          // false
//   print r.error_mask                      // 1
//
//   // Batch check
//   let results = check_batch aviation [-60, 0, 25, 70, 127]
//   // results: array of FluxResult, one per value
//
//   // Type inference: minimal annotations needed
//   let r2 = check nuclear 50
//   // Gluon infers the types. No explicit signatures required.
//
//   // Pattern matching covers every case
//   match r.severity with
//       | Pass -> "All clear"
//       | Caution -> "Watch out"
//       | Warning -> "Take action"
//       | Critical -> "SHUTDOWN"
