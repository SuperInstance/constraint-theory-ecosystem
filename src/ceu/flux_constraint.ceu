// FLUX Constraint Engine -- Céu (Synchronous Reactive)
// Pure INT8 saturated constraint checking. Zero dependencies.
//
// The insight: Céu provides DETERMINISTIC concurrency via synchronous
// reactive programming. Multiple sensor streams can be checked in
// parallel par/and the reactions are deterministic — no race conditions,
// no nondeterminism. Each sensor tick triggers exactly one reaction.
//
// "Synchronous reactive = deterministic concurrency. Every sensor tick
//  produces exactly one check result. No races. No surprises. No doubt."

// ══ Constants ════════════════════════════════════════════════════

#define INT8_MIN -127
#define INT8_MAX  127
#define MAX_CONSTRAINTS 8

// ══ Severity ═════════════════════════════════════════════════════

#define SEV_PASS     0
#define SEV_CAUTION  1
#define SEV_WARNING  2
#define SEV_CRITICAL 3

// ══ Constraint structure ═════════════════════════════════════════

typedef struct {
    int lo;
    int hi;
    char name[32];
} Constraint;

typedef struct {
    int error_mask;
    int severity;
    int violated_lo;
    int violated_hi;
    int violated_count;
    int passed;
} FluxResult;

// ══ Saturate ═════════════════════════════════════════════════════

int saturate(int v) {
    if (v < INT8_MIN) return INT8_MIN;
    if (v > INT8_MAX) return INT8_MAX;
    return v;
}

// ══ Check function ═══════════════════════════════════════════════

FluxResult check(Constraint[] constraints, int value, int n) {
    int val = saturate(value);
    int mask = 0, vlo = 0, vhi = 0, vc = 0;

    loop i in [0 .. n-1] do
        var int lo_fail = val < constraints[i].lo;
        var int hi_fail = val > constraints[i].hi;
        var int failed = lo_fail || hi_fail;
        var int bit = 1 << i;

        if failed then
            mask = mask | bit;
        end
        if lo_fail then
            vlo = vlo | bit;
        end
        if hi_fail then
            vhi = vhi | bit;
        end
        if failed then
            vc = vc + 1;
        end
    end

    // Severity classification
    var int severity;
    if vc == 0 then
        severity = SEV_PASS;
    else if vc <= n / 4 then
        severity = SEV_CAUTION;
    else if vc <= n / 2 then
        severity = SEV_WARNING;
    else
        severity = SEV_CRITICAL;
    end

    return FluxResult(mask, severity, vlo, vhi, vc, vc == 0);
}

// ══ Céu Reactive: sensor monitor ════════════════════════════════
// Each sensor reading triggers a synchronous reaction.
// The reaction is ATOMIC — no interleaving with other reactions.

input int SENSOR_READING;
output FluxResult CHECK_RESULT;

// Aviation preset
var Constraint[] aviation =
    [Constraint(-55,70,"cabin_temp_C"),
     Constraint(75,101,"cabin_pressure_kPa"),
     Constraint(0,100,"fuel_flow_pct"),
     Constraint(60,100,"hydraulic_pct")];

// Nuclear preset
var Constraint[] nuclear =
    [Constraint(0,110,"neutron_flux_pct"),
     Constraint(0,65,"core_temp_C_x10"),
     Constraint(72,100,"pressurizer_pct"),
     Constraint(0,100,"coolant_flow_pct")];

// ══ Main reactive loop ══════════════════════════════════════════
// Every SENSOR_READING event triggers EXACTLY one check.
// Deterministic. No races. No interleaving.

par/or do
    // Sensor 1: Aviation constraints
    every value in SENSOR_READING do
        var FluxResult r = check(aviation, value, 4);
        emit CHECK_RESULT(r);
    end
with
    // Sensor 2: Nuclear constraints (parallel, deterministic)
    every value in SENSOR_READING do
        var FluxResult r = check(nuclear, value, 4);
        emit CHECK_RESULT(r);
    end
end

// ══ Usage ════════════════════════════════════════════════════════
//
// Compile: ceu flux_constraint.ceu --c-main
// Run:     ./flux_constraint
//
// The par/or construct runs both monitors in parallel.
// When EITHER halts, the other is automatically terminated.
// This is DETERMINISTIC — no scheduling nondeterminism.
//
// ══ Why Céu Matters ═════════════════════════════════════════════
//
// Céu's synchronous reactive model is PERFECT for constraint checking:
//
//   1. Each sensor reading is an EVENT
//   2. The check is a REACTION to that event
//   3. Reactions are ATOMIC — no interleaving
//   4. par/and runs multiple monitors deterministically
//   5. No race conditions, no locks, no synchronization
//
// For real-time embedded systems (DO-178C, ISO 26262):
//   - Deterministic = testable = certifiable
//   - Synchronous = predictable timing
//   - Reactive = event-driven by design
//
// The constraint monitor IS the system. No framework. No library.
// Just reactions to sensor events. The language IS the architecture.
