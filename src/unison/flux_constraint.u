-- FLUX Constraint Engine — Unison (2019, Content-Addressed paradigm)
-- Pure INT8 saturated constraint checking. Zero dependencies.
--
-- The insight: Unison code is content-addressed — identified by HASH, not name.
-- A constraint check can NEVER drift because the hash IS the implementation.
-- Rename the function? Same hash. Move it? Same hash.
-- The content-addressed model eliminates versioning, naming, and drift bugs.
--
-- "Code is identified by hash, not name. Constraints can NEVER drift
--  because the hash IS the implementation. Rename, move, refactor — same hash."
--
-- Usage:
--   ucm
--   > load flux_constraint.u

-- ══════════════════════════════════════════════════════════════════════
--  Types
-- ══════════════════════════════════════════════════════════════════════

unique type Severity
  = Pass
  | Caution
  | Warning
  | Critical

unique type ConstraintDef = {
  lo    : Int,
  hi    : Int,
  name  : Text
}

unique type FluxResult = {
  errorMask     : Int,
  severity      : Severity,
  violatedLo    : Int,
  violatedHi    : Int,
  violatedCount : Int,
  passed        : Boolean
}

unique type FluxChecker = {
  constraints : [ConstraintDef]
}

-- ══════════════════════════════════════════════════════════════════════
--  Constants
-- ══════════════════════════════════════════════════════════════════════

int8Min : Int
int8Min = -127

int8Max : Int
int8Max = 127

maxConstraints : Int
maxConstraints = 8

-- ══════════════════════════════════════════════════════════════════════
--  Saturate — pure, total
-- ══════════════════════════════════════════════════════════════════════

saturate : Int -> Int
saturate v =
  if v < int8Min then int8Min
  else if v > int8Max then int8Max
  else v

-- ══════════════════════════════════════════════════════════════════════
--  Severity classification
-- ══════════════════════════════════════════════════════════════════════

severityToString : Severity -> Text
severityToString = cases
  Pass     -> "PASS"
  Caution  -> "CAUTION"
  Warning  -> "WARNING"
  Critical -> "CRITICAL"

classifySeverity : Nat -> Nat -> Severity
classifySeverity violated total =
  if violated == 0 then Pass
  else if violated <= total / 4 then Caution
  else if violated <= total / 2 then Warning
  else Critical

-- ══════════════════════════════════════════════════════════════════════
--  Core check — pure, content-addressed, can never drift
-- ══════════════════════════════════════════════════════════════════════

-- The fold accumulator: (mask, vlo, vhi, idx)
-- After fold: vc is derived from mask popcount

check : FluxChecker -> Int -> FluxResult
check checker value =
  val = saturate value
  cs  = checker.constraints
  nc  = List.size cs

  -- Fold over constraints with index
  foldResult = List.foldLeft
    { acc = (0, 0, 0, 0)
    , step = elem ->
        let (mask, vlo, vhi, idx) = elem.acc
            c = elem.elem
            loFail = val < c.lo
            hiFail = val > c.hi
            failed = loFail || hiFail
            bit    = bitwiseShiftLeft 1 idx
            mask'  = if failed then bitwiseOr mask bit else mask
            vlo'   = if loFail  then bitwiseOr vlo bit else vlo
            vhi'   = if hiFail  then bitwiseOr vhi bit else vhi
            idx'   = idx + 1
        in  (mask', vlo', vhi', idx')
    } cs

  (mask, vlo, vhi, _) = foldResult

  -- Count violations from mask (popcount)
  vc = popcount mask

  sev = classifySeverity vc nc

  { errorMask = mask
  , severity = sev
  , violatedLo = vlo
  , violatedHi = vhi
  , violatedCount = vc
  , passed = (vc == 0)
  }

-- Popcount for violation counting
popcount : Int -> Nat
popcount n =
  go n 0
  go n acc =
    if n == 0 then acc
    else go (bitwiseAnd n (n - 1)) (acc + 1)

-- ══════════════════════════════════════════════════════════════════════
--  Batch check
-- ══════════════════════════════════════════════════════════════════════

batchCheck : FluxChecker -> [Int] -> [FluxResult]
batchCheck checker values =
  List.map (check checker) values

-- ══════════════════════════════════════════════════════════════════════
--  Industry Presets
-- ══════════════════════════════════════════════════════════════════════

aviationPreset : FluxChecker
aviationPreset = { constraints =
  [ { lo = -55, hi = 70,  name = "cabin_temp_C" }
  , { lo = 75,  hi = 101, name = "cabin_pressure_kPa" }
  , { lo = 0,   hi = 100, name = "fuel_flow_pct" }
  , { lo = 60,  hi = 100, name = "hydraulic_pct" }
  ]
}

nuclearPreset : FluxChecker
nuclearPreset = { constraints =
  [ { lo = 0,  hi = 110, name = "neutron_flux_pct" }
  , { lo = 0,  hi = 65,  name = "core_temp_C_x10" }
  , { lo = 72, hi = 100, name = "pressurizer_pct" }
  , { lo = 0,  hi = 100, name = "coolant_flow_pct" }
  ]
}

medicalPreset : FluxChecker
medicalPreset = { constraints =
  [ { lo = 36, hi = 38,  name = "body_temp_C" }
  , { lo = 60, hi = 100, name = "heart_rate_bpm" }
  , { lo = 95, hi = 100, name = "spo2_pct" }
  , { lo = 80, hi = 120, name = "bp_systolic_mmHg" }
  ]
}

-- ══════════════════════════════════════════════════════════════════════
--  Demonstration
-- ══════════════════════════════════════════════════════════════════════

main : '{IO, Exception}
main = do
  printLine "FLUX Constraint Engine — Unison (Content-Addressed)"
  printLine "Code by hash, not name. Constraints can never drift.\n"

  let r1 = check aviationPreset 60
  printLine "Aviation val=60:"
  printLine "  sev=" ++ (severityToString r1.severity)
  printLine "  passed=" ++ (toText r1.passed)

  let r2 = check aviationPreset (-60)
  printLine "\nAviation val=-60:"
  printLine "  sev=" ++ (severityToString r2.severity)
  printLine "  passed=" ++ (toText r2.passed)

  let r3 = check medicalPreset 37
  printLine "\nMedical val=37:"
  printLine "  sev=" ++ (severityToString r3.severity)
  printLine "  passed=" ++ (toText r3.passed)

-- Code is identified by hash, not name. Constraints can NEVER drift
-- because the hash IS the implementation. Rename, move, refactor — same hash.
-- The content-addressed model eliminates versioning, naming, and drift bugs.
